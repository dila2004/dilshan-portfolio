rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isPortfolioAdmin() {
      return request.auth != null
        && request.auth.token.email == 'dilshan4930@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isPortfolioAdmin();
    }

    match /portfolioMessages/{messageId} {
      allow create: if
        request.resource.data.keys().hasAll([
          'name', 'email', 'message', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'message', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 3
        && request.resource.data.email.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 3000
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if false;
    }
  }
}